<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invitation &agrave; une partie</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;padding:24px 0;">
    <tr>
      <td align="center">
        <table width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
          <tr>
            <td style="background-color:#059669;padding:28px 32px;text-align:center;">
              <h1 style="color:#ffffff;font-size:22px;margin:0;font-weight:700;">{{ app_name }}</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="color:#111827;font-size:18px;font-weight:600;margin:0 0 12px;">
                Vous avez &eacute;t&eacute; invit&eacute; &agrave; une partie&nbsp;!
              </h2>
              <p style="color:#4b5563;font-size:14px;line-height:1.6;margin:0 0 8px;">
                <strong>{{ inviter_name }}</strong> vous a invit&eacute; &agrave; rejoindre une partie de cartes FapFap.
              </p>
              <p style="color:#6b7280;font-size:13px;line-height:1.6;margin:0 0 24px;">
                Cliquez sur l&rsquo;un des boutons ci-dessous pour accepter ou refuser cette invitation.
              </p>
              <table cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="padding-right:6px;padding-bottom:24px;width:50%;" align="right">
                    <a href="{{ accept_link }}" style="display:inline-block;background-color:#059669;color:#ffffff;font-size:15px;font-weight:600;padding:12px 28px;border-radius:8px;text-decoration:none;">
                      Accepter
                    </a>
                  </td>
                  <td style="padding-left:6px;padding-bottom:24px;width:50%;" align="left">
                    <a href="{{ decline_link }}" style="display:inline-block;background-color:#e5e7eb;color:#374151;font-size:15px;font-weight:600;padding:12px 28px;border-radius:8px;text-decoration:none;">
                      Refuser
                    </a>
                  </td>
                </tr>
              </table>
              <p style="color:#9ca3af;font-size:12px;line-height:1.5;margin:0;">
                Les boutons ne fonctionnent pas&nbsp;?
                <br>
                Accepter&nbsp;: <span style="color:#059669;word-break:break-all;">{{ accept_link }}</span>
                <br>
                Refuser&nbsp;: <span style="color:#374151;word-break:break-all;">{{ decline_link }}</span>
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f9fafb;padding:20px 32px;text-align:center;">
              <p style="color:#9ca3af;font-size:12px;margin:0;">
                {{ app_name }} &middot; <a href="{{ frontend_url }}" style="color:#059669;">{{ frontend_url }}</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
