<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expuls&eacute; de la partie</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;padding:24px 0;">
    <tr>
      <td align="center">
        <table width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
          <tr>
            <td style="background-color:#dc2626;padding:28px 32px;text-align:center;">
              <h1 style="color:#ffffff;font-size:22px;margin:0;font-weight:700;">{{ app_name }}</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="color:#111827;font-size:18px;font-weight:600;margin:0 0 12px;">
                Vous avez &eacute;t&eacute; expuls&eacute; de la partie
              </h2>
              <p style="color:#4b5563;font-size:14px;line-height:1.6;margin:0 0 12px;">
                Vous avez &eacute;t&eacute; expuls&eacute; de la partie <strong>{{ game_id }}</strong> pour inactivit&eacute;.
              </p>
              <p style="color:#dc2626;font-size:14px;font-weight:600;line-height:1.6;margin:0 0 24px;">
                Vous avez perdu votre mise de {{ bet }} cr&eacute;dits.
              </p>
              <p style="color:#6b7280;font-size:13px;line-height:1.6;margin:0;">
                Restez actif dans vos prochaines parties pour &eacute;viter de perdre vos mises.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f9fafb;padding:20px 32px;text-align:center;">
              <p style="color:#9ca3af;font-size:12px;margin:0;">
                {{ app_name }} &middot; <a href="{{ frontend_url }}" style="color:#059669;">{{ frontend_url }}</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
