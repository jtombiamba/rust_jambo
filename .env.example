# ─────────────────────────────────────────────────────────────────────────────
# JAMBO — Environment Variables
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults defined in backend/src/config.rs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=info
RUST_LOG=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jambo
DB_POOL_MAX_CONNECTIONS=100
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_CONNECT_TIMEOUT_SECS=8
DB_POOL_ACQUIRE_TIMEOUT_SECS=8
DB_POOL_IDLE_TIMEOUT_SECS=300
DB_POOL_MAX_LIFETIME_SECS=1800
DB_POOL_METRICS_INTERVAL_SECS=30

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f
MAX_RABBITMQ_CONNECTION_RETRIES=10
RABBITMQ_PUBLISH_MAX_RETRIES=3
RABBITMQ_PUBLISH_INITIAL_RETRY_DELAY_MS=100
RABBITMQ_PUBLISH_MAX_RETRY_DELAY_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECS=30

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=super-secret-key-change-me-in-production-please-do-it-now
JWT_EXPIRY_HOURS=24
IP_HASH_PEPPER=ip-pepper-change-me-1234567890abcdef

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_MAX_AGE=3600

# ── Game ────────────────────────────────────────────────────────────────────
GAME_STALENESS_THRESHOLD_SECS=60
GAME_HUMAN_STALENESS_ALERT_SECS=900
GAME_HUMAN_STALENESS_KICK_SECS=1800
RUN_STALENESS_TIMEOUT_SECS=1800
ROOM_MAX_PLAYERS=4

# ── Credits & Freeze ────────────────────────────────────────────────────────
DEFAULT_CREDIT=100
FREEZE_DURATION_SECS=86400
UNFREEZE_CREDIT_NO_PAYMENT=50
UNFREEZE_CREDIT_WITH_PAYMENT=250

# ── Top-up ──────────────────────────────────────────────────────────────────
TOPUP_CREDIT_AMOUNT=250
TOPUP_MONTHLY_LIMIT_EUR_CENTS=10000

# ── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_UNFREEZE_AMOUNT_EUR=1.20
PAYPAL_TOPUP_AMOUNT_EUR=1.20
PAYPAL_SANDBOX_URL=https://api-m.sandbox.paypal.com
PAYPAL_LIVE_URL=https://api-m.paypal.com
PAYPAL_DONATE_URL=https://www.paypal.me/jtombi

# ── Cashout ──────────────────────────────────────────────────────────────────
# Player-requested PayPal payouts. Credits are reserved and the account locked
# while an admin reviews the request. PayPal Payouts must be enabled on the
# PayPal account for `admin-cli cashout pay` to work.
CASHOUT_ENABLED=false
CASHOUT_CREDITS_PER_EUR=250
CASHOUT_MIN_CREDITS=250
CASHOUT_MAX_EUR_CENTS=2000
CASHOUT_ADMIN_EMAIL=
CASHOUT_AUTO_REJECT_AFTER_SECS=86400

# ── Admin CLI ────────────────────────────────────────────────────────────────
# Optional: supply the admin keypass non-interactively (CI/cron). Leave empty
# to be prompted interactively.
ADMIN_CLI_KEYPASS=

# ── Rate Limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_MAX_REQUESTS=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=3600
RATE_LIMIT_CONTACT_MAX_REQUESTS=5
RATE_LIMIT_CONTACT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_PASSWORD_MAX_REQUESTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_PASSWORD_MAX_REQUESTS=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=60

# ── Mailer (SMTP) ───────────────────────────────────────────────────────────
MAILER_MODE=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_TLS=false
SMTP_FROM_EMAIL=noreply@jambo.local
SMTP_FROM_NAME="Jambo Game"
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI Worker ───────────────────────────────────────────────────────────────
AI_WORKER_MAX_CONCURRENT=50
AI_WORKER_DB_POOL_SIZE=100
BOT_THINKING_DELAY_MS=800
TOKIO_WORKER_THREADS=

# ── Benchmark ───────────────────────────────────────────────────────────────
BENCHMARK_MODE=false
BENCHMARK_BOT_DELAY_MS=100
BENCHMARK_SKIP_CREDIT_CHECK=true
BENCHMARK_API_TOKEN=

# ── API Documentation (OpenAPI / Swagger UI) ────────────────────────────────
# Set to true to serve the interactive Swagger UI at /swagger-ui/
# (the raw spec at /api-docs/openapi.json is always available).
ENABLE_API_DOCS=false

# ── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=changeme
DOZZLE_USER=admin
DOZZLE_PASSWORD=changeme

# ── Grafana Alerting ─────────────────────────────────────────────────────────
# Slack webhook URLs are channel-bound (each URL targets #alerts-critical or
# #alerts-warning). Grafana 13 still requires a non-empty `recipient` (channel
# name or ID) for Slack contact points, so set the *_CHANNEL vars too.
# Email requires GF_SMTP_* set on the Grafana container.
SLACK_CRITICAL_WEBHOOK_URL=
SLACK_CRITICAL_CHANNEL=#alerts-critical
SLACK_WARNING_WEBHOOK_URL=
SLACK_WARNING_CHANNEL=#alerts-warning
EMAIL_ONCALL=oncall@jambo.local
EMAIL_TEAM=team@jambo.local
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mailhog:1025
GF_SMTP_FROM_ADDRESS=alerts@jambo.local

# ── DB Backup (S3-compatible storage) ─────────────────────────────────────────
# Used by the `backup` service (docker compose) and the `db-backup` CronJob (k8s).
# The backup runs daily at 02:00 and keeps BACKUP_RETENTION_DAYS days of dumps.
#
# S3_ENDPOINT points at any S3-compatible store (AWS S3, MinIO, Cloudflare R2,
# RustFS, ...). The backup container runs on its own network, so reach an
# out-of-cluster store via its host-published address, e.g.:
#   - Docker Desktop:          http://host.docker.internal:9000
#   - plain Linux / Coolify:   http://<docker-host-ip>:9000
#                              (or the bridge gateway, e.g. http://172.17.0.1:9000)
# Plain HTTP does not need S3_INSECURE; set S3_INSECURE=true only for
# self-signed TLS endpoints.
S3_ENDPOINT=
S3_BUCKET=
# S3_PREFIX must end with a trailing slash so keys land at "backups/<file>".
S3_PREFIX=backups/
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_INSECURE=false
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SCHEDULE="0 2 * * *"
