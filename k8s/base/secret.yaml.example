# ─────────────────────────────────────────────────────────────────────────────
# Jambo — Kubernetes Secret template (DO NOT commit real values)
#
# This file documents the keys that must exist in the `jambo-secrets` Secret.
# It is NOT applied by kustomize (see k8s/base/kustomization.yaml). The actual
# Secret is created at deploy time by scripts/minikube-up.sh from the gitignored
# `.env` file (random values are generated for local dev if a key is missing).
#
# To use this template locally:
#   cp k8s/base/secret.yaml.example .env
#   # fill in real values, then run scripts/minikube-up.sh
# ─────────────────────────────────────────────────────────────────────────────

# Backend / workers (consumed via envFrom -> secretRef: jambo-secrets)
JWT_SECRET=change-me
JWT_EXPIRY_HOURS=24
IP_HASH_PEPPER=change-me
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BENCHMARK_API_TOKEN=

# Monitoring nginx basic-auth (consumed via secretKeyRef: monitoring-nginx-secrets)
PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=changeme
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Alertmanager (consumed via secretKeyRef: alertmanager-secrets)
SLACK_CRITICAL_WEBHOOK_URL=
SLACK_WARNING_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
